# Required in production (Cloudflare Worker + local).
AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://127.0.0.1:43173

# Native builds (Capacitor) load this URL in the WebView.
# Set it to your public HTTPS origin before `npx cap sync`.
CAPACITOR_SERVER_URL=

# Optional. Without these, local signup unlocks the timer in development mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional. App Store receipt verification for iOS IAP.
APPLE_SHARED_SECRET=

# Local default: SQLite file. On Cloudflare Workers this path is not available.
# Use a remote Turso/libSQL URL, e.g. libsql://your-db.turso.io
DATABASE_URL=file:data/tabata.db
DATABASE_AUTH_TOKEN=

# Cloudflare dashboard (Worker `tabata`) — set as secrets/vars for both
# build and runtime. Do not commit real values.
# Required: AUTH_SECRET, APP_URL, DATABASE_URL, DATABASE_AUTH_TOKEN
# Optional: STRIPE_SECRET_KEY, STRIPE_PRICE_ID, STRIPE_WEBHOOK_SECRET,
#           APPLE_SHARED_SECRET, CAPACITOR_SERVER_URL
